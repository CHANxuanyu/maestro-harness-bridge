#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const { setTimeout: delay } = require('node:timers/promises');
const { createCopilotTurn } = require('./copilot-protocol.cjs');

// Official @github/copilot@1.0.63 app.js: Commander prompt/resume flags and kft version.
// Scenario controls never enter native stdout or session records.
async function run() {
	const args = process.argv.slice(2);
	if (args.includes('--version'))
		return console.log("GitHub Copilot CLI 1.0.63.\nRun 'copilot update' to check for updates.");
	if (args.includes('--help')) return console.log('-p --resume --output-format json');
	const prompt = args[args.indexOf('-p') + 1];
	if (!args.includes('-p') || !prompt) throw new Error('The native headless prompt is required');
	if (!process.env.COPILOT_HOME || !process.env.MAESTRO_NATIVE_SCRIPT)
		throw new Error('Missing isolated fixture directories');
	const configDir = process.env.COPILOT_HOME;
	fs.mkdirSync(configDir, { recursive: true });
	const script = JSON.parse(fs.readFileSync(process.env.MAESTRO_NATIVE_SCRIPT, 'utf8'));
	const countFile = path.join(configDir, 'fixture-turn-count');
	const count = fs.existsSync(countFile) ? Number(fs.readFileSync(countFile)) : 0;
	const scene = script.scene || script.turns[count];
	if (!scene) throw new Error(`No scripted turn ${count}`);
	fs.writeFileSync(countFile, String(count + 1));
	fs.writeFileSync(path.join(configDir, 'fixture-process'), String(process.pid));

	const turn = createCopilotTurn({
		configDir,
		cwd: process.cwd(),
		prompt,
		id: args.find((arg) => arg.startsWith('--resume='))?.slice('--resume='.length),
		emit: (event) => process.stdout.write(`${JSON.stringify(event)}\n`),
	});
	let stopped = false;
	process.once('SIGINT', () => {
		stopped = true;
		turn.stop();
		process.exitCode = 130;
	});
	for (const tool of scene.tools || []) turn.startTool(tool);
	if (scene.waitForStop) {
		while (!stopped) await delay(25);
		return;
	}
	for (const tool of [...(scene.tools || [])].reverse()) {
		for (const gate of tool.gates || []) while (!fs.existsSync(gate) && !stopped) await delay(10);
		await delay(scene.toolDelay ?? 300);
		if (stopped) return;
		turn.finishTool(tool);
	}
	if (!stopped) turn.finish(scene.answer);
}
run().catch((error) => {
	console.error(error.message);
	process.exitCode = 1;
});
