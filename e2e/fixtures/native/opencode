#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const { setTimeout: delay } = require('node:timers/promises');
const { createOpenCodeTurn } = require('./opencode-protocol.cjs');

async function run() {
	const args = process.argv.slice(2);
	if (args.includes('--version')) return console.log('1.19.4');
	if (args.includes('--help')) return console.log('run --format json --session <id>');
	// Official packages/opencode/src/cli/cmd/models.ts prints provider/model IDs.
	if (args[0] === 'models') return console.log('openai/gpt-4.1');
	if (args[0] !== 'run') throw new Error('Only the documented run invocation is supported');
	if (!process.env.XDG_DATA_HOME || !process.env.MAESTRO_NATIVE_SCRIPT)
		throw new Error('Missing isolated fixture directories');
	const configDir = path.join(process.env.XDG_DATA_HOME, 'opencode');
	fs.mkdirSync(configDir, { recursive: true });
	const script = JSON.parse(fs.readFileSync(process.env.MAESTRO_NATIVE_SCRIPT, 'utf8'));
	const countFile = path.join(configDir, 'fixture-turn-count');
	const count = fs.existsSync(countFile) ? Number(fs.readFileSync(countFile)) : 0;
	const scene = script.scene || script.turns[count];
	if (!scene) throw new Error(`No scripted turn ${count}`);
	fs.writeFileSync(countFile, String(count + 1));
	fs.writeFileSync(path.join(configDir, 'fixture-process'), String(process.pid));
	let prompt = args.includes('--') ? args.slice(args.indexOf('--') + 1).join(' ') : '';
	if (!prompt) for await (const chunk of process.stdin) prompt += chunk;
	const turn = createOpenCodeTurn({
		configDir,
		cwd: process.cwd(),
		prompt,
		id: args.includes('--session') ? args[args.indexOf('--session') + 1] : undefined,
		emit: (event) => process.stdout.write(`${JSON.stringify(event)}\n`),
	});
	let stopped = false;
	const tools = scene.tools || [];
	process.once('SIGINT', () => {
		stopped = true;
		for (const tool of tools) turn.finishTool(tool, 'canceled');
		turn.stop();
		process.exitCode = 130;
	});
	for (const tool of tools) turn.startTool(tool);
	if (scene.waitForStop) {
		while (!stopped) await delay(25);
		return;
	}
	for (const tool of [...tools].reverse()) {
		for (const gate of tool.gates || []) while (!fs.existsSync(gate) && !stopped) await delay(10);
		await delay(scene.toolDelay ?? 300);
		if (stopped) return;
		turn.finishTool(tool, tool.status);
	}
	if (!stopped) turn.finish(scene.answer);
}
run().catch((error) => {
	console.error(error.message);
	process.exitCode = 1;
});
