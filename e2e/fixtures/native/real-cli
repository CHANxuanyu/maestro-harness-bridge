#!/usr/bin/env node
'use strict';

// Relay the actual CLI's args, stdin, stdout and stderr without translating
// any native events. The optional test gate holds exit only after it finishes,
// letting history acceptance snapshot the original transcript before synopsis.
const fs = require('node:fs');
const { spawn } = require('node:child_process');
const { setTimeout: delay } = require('node:timers/promises');
const args = process.argv.slice(2);
const inspection = args.includes('--version') || args.includes('--help');
const control =
	!inspection && fs.existsSync(process.env.MAESTRO_E2E_CONTROL)
		? JSON.parse(fs.readFileSync(process.env.MAESTRO_E2E_CONTROL, 'utf8'))
		: {};
if (!inspection && control.record) {
	const count = fs.existsSync(control.record)
		? fs.readFileSync(control.record, 'utf8').trim().split('\n').filter(Boolean).length
		: 0;
	if (count >= control.maxInvocations) {
		console.error('Acceptance turn budget exceeded');
		process.exit(1);
	}
	fs.appendFileSync(
		control.record,
		JSON.stringify({
			args,
			cwd: process.cwd(),
			...(control.recordCaller
				? {
						caller: {
							agentId: process.env.MAESTRO_CALLER_AGENT_ID,
							tabId: process.env.MAESTRO_CALLER_TAB_ID,
						},
					}
				: {}),
		}) + '\n'
	);
}
// A loopback relay observes only the DeepSeek request shape. The app retains
// its real preset endpoint and key; no environment is written to evidence.
const env = { ...process.env };
if (control.deepseekProxy) {
	const url = new URL(control.deepseekProxy);
	if (url.protocol !== 'http:' || url.hostname !== '127.0.0.1')
		throw new Error('DeepSeek observation requires a loopback HTTP relay');
	env.ANTHROPIC_BASE_URL = url.href.replace(/\/$/, '');
}
const child = spawn(process.env.MAESTRO_E2E_CLI, args, { stdio: 'inherit', env });
if (!inspection) fs.writeFileSync(process.env.MAESTRO_E2E_PROCESS, String(child.pid));
for (const signal of ['SIGINT', 'SIGTERM']) process.on(signal, () => child.kill(signal));
child.on('error', (error) => {
	console.error(error.message);
	process.exitCode = 1;
});
child.on('exit', async (code, signal) => {
	if (code === 0 && control.exitGate && !args.includes('--no-session-persistence'))
		while (!fs.existsSync(control.exitGate)) await delay(10);
	process.exitCode = code ?? (signal === 'SIGINT' ? 130 : 1);
});
